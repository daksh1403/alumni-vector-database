{
  "name": "alumni-vector-database",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "npm test && npm run test:ui && wrangler deploy --dry-run",
    "seed": "node --env-file=.dev.vars scripts/seed.js",
    "evaluate": "node --env-file=.dev.vars scripts/evaluate.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "4.151.1"
  }
}
